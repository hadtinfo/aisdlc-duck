# Image web AISDLC (Go): dựng UI React, nhúng vào binary tĩnh, chạy trên distroless.
FROM node:22-alpine AS ui
WORKDIR /src/web/ui
COPY web/ui/package.json web/ui/package-lock.json ./
RUN npm ci
COPY web/ui/ ./
RUN npm run build

FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN rm -rf internal/web/spa/dist
COPY --from=ui /src/web/ui/dist/ internal/web/spa/dist/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/aisdlc-web ./cmd/aisdlc-web \
 && mkdir /out/data

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/aisdlc-web /aisdlc-web
# Khóa ký nằm ở /data (mặc định AISDLC_SIGNING_KEY_FILE=/data/signing-key), thư mục ghi được cho uid 65532.
COPY --from=build --chown=65532:65532 /out/data /data
VOLUME /data
EXPOSE 8080
ENTRYPOINT ["/aisdlc-web"]
