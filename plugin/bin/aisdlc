#!/usr/bin/env bash
# Chọn binary Go theo nền tảng (plugin/lib/aisdlc-<os>-<arch>) rồi exec.
# Thiếu binary: lệnh thường -> lỗi, exit 2. Hook -> chỉ chặn (fail closed) khi đang ở repo AISDLC.
# tool_name lấy ở cấp ngoài (trước hoặc sau khối tool_input, không lấy từ bên trong tool_input).
# Riêng pre-tool-use: tool chỉ đọc (Read, Grep, Glob, LS, NotebookRead) vẫn được qua (exit 0) để dev còn đọc mà sửa;
# tool ghi, Bash, tool lạ hoặc không đọc được tool_name -> chặn (exit 2). WebFetch/WebSearch không thuộc danh sách
# (hook không đăng ký cho chúng; nếu có gọi thì coi như không phải tool đọc repo và vẫn chặn).
fail() { # đọc $MSG; $1 = hook?, $2 = sự kiện
  if [ "${1:-}" != "hook" ]; then echo "AISDLC: $MSG" >&2; exit 2; fi
  local in="" dir="$PWD"
  IFS= read -r -d '' in || true
  local tool=""
  # tool_name cấp ngoài (bất kể thứ tự khóa): thay mỗi chuỗi JSON bằng token "sN" (nội dung cất ở mảng), bỏ mọi đối tượng
  # lồng nhau, rồi tìm khóa tool_name ở đối tượng ngoài cùng. Không tìm ra hoặc không rõ -> tool rỗng -> chặn.
  local -a strs=(); local t="" rest="$in" n=0 q='"'
  while [[ "$rest" =~ ^([^\"]*)\"((\\.|[^\"\\])*)\"(.*)$ ]]; do
    strs[n]="${BASH_REMATCH[2]}"; t+="${BASH_REMATCH[1]}\"s$n\""; rest="${BASH_REMATCH[4]}"; n=$((n+1))
  done
  t+="$rest"
  t="${t#*\{}" # bỏ dấu { mở của đối tượng ngoài
  while [[ "$t" =~ ^(.*)\{[^{}]*\}(.*)$ ]]; do t="${BASH_REMATCH[1]}${BASH_REMATCH[2]}"; done
  rest="$t"
  while [[ "$rest" =~ \"s([0-9]+)\"[[:space:]]*:[[:space:]]*\"s([0-9]+)\"(.*)$ ]]; do
    if [ "${strs[${BASH_REMATCH[1]}]}" = "tool_name" ]; then tool="${strs[${BASH_REMATCH[2]}]}"; break; fi
    rest="${BASH_REMATCH[3]}"
  done
  [[ "$in" =~ \"cwd\"[[:space:]]*:[[:space:]]*\"([^\"]+)\" ]] && dir="${BASH_REMATCH[1]}"
  while [ -n "$dir" ]; do
    if [ -f "$dir/aisdlc/config.yaml" ]; then
      if [ "${2:-}" = "pre-tool-use" ]; then
        case "$tool" in Read|Grep|Glob|LS|NotebookRead) exit 0 ;; esac
        echo "AISDLC: $MSG" >&2
        exit 2
      fi
      echo "AISDLC: $MSG" >&2
      exit 1
    fi
    [ "$dir" = "/" ] && break
    dir="${dir%/*}"; [ -z "$dir" ] && dir="/"
  done
  exit 0
}
OS="$(uname -s | tr 'A-Z' 'a-z')"
case "$(uname -m)" in
  x86_64|amd64) ARCH=amd64 ;;
  aarch64|arm64) ARCH=arm64 ;;
  *) ARCH="$(uname -m)" ;;
esac
BIN="$(dirname "$(readlink -f "$0")")/../lib/aisdlc-$OS-$ARCH"
if [ ! -x "$BIN" ]; then
  MSG="không tìm thấy binary aisdlc cho $OS/$ARCH. Chạy plugin/install.sh."
  fail "$@"
fi
exec "$BIN" "$@"
